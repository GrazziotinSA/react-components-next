{
  "name": "@grazziotin/react-components-next",
  "version": "2.2.1",
  "description": "Biblioteca de componentes React reutilizáveis",
  "private": false,
  "exports": {
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.mjs",
      "require": "./dist/ui/index.js"
    },
    "./functions": {
      "types": "./dist/functions/index.d.ts",
      "import": "./dist/functions/index.mjs",
      "require": "./dist/functions/index.js"
    },
    "./accessibility": {
      "types": "./dist/accessibility/index.d.ts",
      "import": "./dist/accessibility/index.mjs",
      "require": "./dist/accessibility/index.js"
    },
    "./styles": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:css": "tailwindcss -i ./src/styles/index.css -o ./dist/index.css --minify",
    "build:css:src": "tailwindcss -i ./src/styles/index.css -o ./src/styles/tailwind-output.css --minify",
    "build:lib": "npm run build:css:src && tsup && npm run build:css",
    "build:lib:watch": "tsup --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build:lib"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "typescript",
    "tailwindcss"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mantine/core": "^9.2.1",
    "@mantine/hooks": "^9.2.1",
    "@mui/material": "^9.0.1",
    "@mui/x-data-grid": "^9.4.0",
    "clsx": "^2.1.1",
    "next": "^15.5.18",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-icons": "^5.6.0",
    "react-say": "^2.2.1",
    "react-toastify": "^11.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "overrides": {
    "caniuse-lite": "1.0.30001792"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-storybook": "^10.4.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "storybook": "^10.4.0",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vite": "^8.0.13",
    "vitest": "^4.1.7"
  }
}
