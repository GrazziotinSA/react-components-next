{
  "name": "@grazziotin/react-components-next",
  "version": "3.1.15",
  "description": "Biblioteca de componentes React reutilizáveis",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.mjs",
      "require": "./dist/ui/index.js"
    },
    "./functions": {
      "types": "./dist/functions/index.d.ts",
      "import": "./dist/functions/index.mjs",
      "require": "./dist/functions/index.js"
    },
    "./accessibility": {
      "types": "./dist/accessibility/index.d.ts",
      "import": "./dist/accessibility/index.mjs",
      "require": "./dist/accessibility/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.mjs",
      "require": "./dist/providers/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.mjs",
      "require": "./dist/hooks/index.js"
    },
    "./styles": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:css": "tailwindcss -i ./src/styles/index.css -o ./dist/index.css --minify",
    "build:css:src": "tailwindcss -i ./src/styles/index.css -o ./src/styles/tailwind-output.css --minify",
    "build:lib": "npm run build:css:src && tsup && npm run build:css",
    "build:lib:watch": "npm run build:css:src && tsup --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build:lib"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "typescript",
    "tailwindcss"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "@base-ui/react": "^1.7.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mantine/core": "^9.2.1",
    "@mantine/hooks": "^9.2.1",
    "@mui/material": "^9.0.1",
    "@mui/x-data-grid": "^9.4.0",
    "@tanstack/react-query": "^5.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "use-immer": "^0.11.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react-icons": "^5.6.0",
    "react-say": "^2.2.1",
    "tailwind-merge": "^3.6.0"
  },
  "overrides": {
    "caniuse-lite": "1.0.30001792",
    "esbuild": ">=0.28.1",
    "vitest": "^4.1.10",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@chromatic-com/storybook": "^5.2.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mantine/core": "^9.2.1",
    "@mantine/hooks": "^9.2.1",
    "@mui/material": "^9.0.1",
    "@mui/x-data-grid": "^9.4.0",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query": "^5.100.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-storybook": "^10.4.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "react-toastify": "^11.1.0",
    "storybook": "^10.4.0",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "typescript-eslint": "^8.63.0",
    "use-immer": "^0.11.0",
    "vite": "^8.0.13",
    "vitest": "^4.1.10"
  }
}
